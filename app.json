{
  "expo": {
    "name": "AppPeladas",
    "slug": "apppeladas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apppeladas",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalenbsb.apppeladas",
      "infoPlist": {
        "CFBundleDisplayName": "AppPeladas",
        "NSCameraUsageDescription": "O AppPeladas usa a câmera para fotografar o atleta.",
        "NSPhotoLibraryUsageDescription": "O AppPeladas usa suas fotos para a imagem do atleta."
      }
    },
    "android": {
      "package": "com.dalenbsb.apppeladas",
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4332",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O AppPeladas usa suas fotos para a imagem do atleta.",
          "cameraPermission": "O AppPeladas usa a câmera para fotografar o atleta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
